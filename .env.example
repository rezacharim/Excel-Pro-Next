# Excel Pro Soccer Academy - environment variables
# Copy this file to .env.local and fill in real values.

# Base URL of the backend API (NestJS), no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe publishable key (pk_test_... or pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs for each division subscription ($350 CAD / 2 months)
NEXT_PUBLIC_U5_U8=price_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_U9_U12=price_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_U13_U14=price_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_U15_U18=price_xxxxxxxxxxxxxxxxxxxxxxxx
